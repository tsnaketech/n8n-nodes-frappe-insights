{
	"name": "n8n-nodes-frappe-insights",
	"version": "0.1.0",
	"description": "n8n node for Frappe Insights: workbooks, queries, charts, dashboards, data sources and alerts",
	"license": "MIT",
	"homepage": "https://github.com/tsnaketech/n8n-nodes-frappe-insights#readme",
	"keywords": [
		"n8n-community-node-package",
		"frappe",
		"frappe-insights",
		"insights",
		"analytics",
		"business-intelligence"
	],
	"author": {
		"name": "tsnaketech",
		"email": "snaketech@proton.me",
		"url": "https://github.com/tsnaketech"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/tsnaketech/n8n-nodes-frappe-insights.git"
	},
	"bugs": {
		"url": "https://github.com/tsnaketech/n8n-nodes-frappe-insights/issues"
	},
	"scripts": {
		"clean": "rimraf dist",
		"build": "tsc && gulp build:icons",
		"rebuild": "npm run clean && npm run build",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials package.json gulpfile.js --write",
		"format:check": "prettier nodes credentials package.json gulpfile.js --check",
		"lint": "eslint nodes credentials package.json ",
		"lint:fix": "eslint nodes credentials package.json --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"ci": "npm run format:check && npm run lint && npm run test",
		"prepack": "npm run rebuild"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/FrappeApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/FrappeInsights/FrappeInsights.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "0.42.0",
		"eslint": "9.39.5",
		"gulp": "5.0.1",
		"prettier": "3.9.6",
		"release-it": "21.0.1",
		"rimraf": "6.1.3",
		"typescript": "5.9.3",
		"vitest": "4.1.10"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
